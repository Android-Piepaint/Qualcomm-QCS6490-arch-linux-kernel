# Kernel tree is pre-cloned by the workflow and passed in via $KSRC
pkgname=linux-sc7280
pkgver=0            # real value comes from pkgver() below
pkgrel=${PKGREL:-1}
pkgdesc='Mainline Linux for Qualcomm SC7280/QCS6490 (Radxa Dragon Q6A)'
arch=(aarch64)
url='https://github.com/sc7280-mainline/linux'
license=(GPL-2.0-only)
depends=(coreutils initramfs kmod)
optdepends=('linux-firmware: firmware for GPU/Wi-Fi/etc')
makedepends=(bc cpio gettext pahole perl python tar xz zstd kmod)
options=(!strip !debug !lto)
source=(config)
sha256sums=(SKIP)

: "${KSRC:?set KSRC to the kernel source tree}"

pkgver() {
  make -C "$KSRC" -s kernelversion | tr - _
}

prepare() {
  cd "$KSRC"
  touch .scmversion                      # stop git-describe suffixes in the release string
  mkdir -p "$srcdir/build"
  cp "$srcdir/config" "$srcdir/build/.config"

  # Tweaks on top of your config: drop debug info (huge), set a local version
  scripts/config --file "$srcdir/build/.config" \
    --set-str LOCALVERSION "-sc7280" -d LOCALVERSION_AUTO \
    -d DEBUG_INFO_BTF -d DEBUG_INFO_BTF_MODULES \
    -d DEBUG_INFO_DWARF5 -d DEBUG_INFO_DWARF4 -d DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT \
    -e DEBUG_INFO_NONE

  make O="$srcdir/build" olddefconfig
}

build() {
  cd "$KSRC"
  make O="$srcdir/build" Image modules dtbs
}

package() {
  cd "$KSRC"
  local kver moddir
  kver=$(<"$srcdir/build/include/config/kernel.release")
  moddir="$pkgdir/usr/lib/modules/$kver"

  # vmlinuz + pkgbase are what mkinitcpio's pacman hook looks for
  install -Dm644 "$srcdir/build/arch/arm64/boot/Image" "$moddir/vmlinuz"
  echo "$pkgname" | install -Dm644 /dev/stdin "$moddir/pkgbase"

  make O="$srcdir/build" INSTALL_MOD_PATH="$pkgdir/usr" INSTALL_MOD_STRIP=1 \
       DEPMOD=/doesnt/exist modules_install
  rm -f "$moddir"/build "$moddir"/source

  make O="$srcdir/build" INSTALL_DTBS_PATH="$pkgdir/boot/dtbs/$pkgname" dtbs_install

  install -Dm644 /dev/stdin "$pkgdir/etc/mkinitcpio.d/$pkgname.preset" <<PRESET
ALL_kver="/boot/vmlinuz-$pkgname"
PRESETS=('default')
default_image="/boot/initramfs-$pkgname.img"
PRESET
}
